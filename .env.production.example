APP_NAME=RebateOps
APP_ENV=production
APP_KEY=                          # php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://yourdomain.com    # thay bằng domain thật trên Hostinger

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error                   # production: chỉ log lỗi thật

# ──────────────────────────────────────────────
# DATABASE — dùng MySQL trên Hostinger
# Tạo DB trong hPanel → Databases → MySQL Databases
# ──────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_db_name          # tên DB tạo trong hPanel
DB_USERNAME=your_db_user          # user DB tạo trong hPanel
DB_PASSWORD=your_db_password

# ──────────────────────────────────────────────
# SESSION / CACHE / QUEUE — giữ database driver
# Queue chạy qua Cron Job (xem hướng dẫn hPanel)
# ──────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ──────────────────────────────────────────────
# GOOGLE SHEETS
# Upload google-auth.json vào storage/app/ trên server
# ──────────────────────────────────────────────
GOOGLE_SPREADSHEET_ID=            # ID từ URL Google Sheet
GOOGLE_SERVICE_ACCOUNT_PATH=storage/app/google-auth.json

VITE_APP_NAME="${APP_NAME}"
